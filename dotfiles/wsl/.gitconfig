[alias]
	l = log --graph --decorate --oneline
	s = status -b -s

[core]
	autocrlf = input

[init]
	defaultBranch = main

[pull]
	rebase = false

[push]
	default = current

[user]
	name = lisp719
	email = 368034+lisp719@users.noreply.github.com

[gui]
	encoding = utf-8

# for wsl
[credential]
	helper = /mnt/c/Program\\ Files/Git/ucrt64/bin/git-credential-manager.exe

[delta]
	navigate = true

[interactive]
	diffFilter = delta --color-only

[merge]
	conflictstyle = zdiff3
