prefix_rule(
  pattern = ["gh", "pr", ["edit", "merge"]],
  decision = "prompt",
)

prefix_rule(
  pattern = ["rm"],
  decision = "prompt",
)

prefix_rule(
  pattern = ["docker", "scout", "cves"],
  decision = "allow",
)

prefix_rule(
  pattern = ["jj", ["diff", "st", "status"]],
  decision = "allow",
)
