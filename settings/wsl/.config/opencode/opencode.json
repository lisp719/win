{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "gh issue list *": "allow",
      "gh issue view *": "allow",
      "gh pr list *": "allow",
      "gh pr view *": "allow",

      "jj bookmark list *": "allow",
      "jj diff *": "allow",
      "jj file list *": "allow",
      "jj file show *": "allow",
      "jj log *": "allow",
      "jj show *": "allow",
      "jj status *": "allow",

      "cat *": "allow",
      "echo *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "ls *": "allow",
      "rg *": "allow",
      "sed *": "allow",
      "sort *": "allow",
      "tail *": "allow",
      "uniq *": "allow",
      "wc *": "allow",

      "curl *": "deny",
      "git *": "deny",
      "node *": "deny",
      "python *": "deny",
      "python3 *": "deny"
    },
    "edit": {
      "*": "ask"
    }
  }
}
